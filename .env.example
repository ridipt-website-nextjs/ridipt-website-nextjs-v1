# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored (see .gitignore's `.env*` rule) — never commit real secrets.

# --- Database (required) ---
# MongoDB connection string. Without this, every API route that touches the
# database (leads, dpdp-leads, blogs, jobs, applications, admin) returns 500.
MONGODB_URI=

# --- Outbound email (required for lead/application notification emails) ---
# Used by src/lib/email.service.ts for admin notifications + confirmation emails
# (Get in Touch, Careers applications, DPDP Readiness Assessment requests).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME="Ridipt Technologies"
FROM_EMAIL=

# --- Auth (required for admin login / OTP verification) ---
JWT_SECRET=

# --- File uploads (required for career applications / attachments via S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# --- Firebase Analytics (optional) ---
# If unset, analytics silently no-ops — the rest of the site works fine without it.
# Should be a JSON string, e.g. FIREBASE_CONFIG={"apiKey":"...","projectId":"...", ...}
FIREBASE_CONFIG=
